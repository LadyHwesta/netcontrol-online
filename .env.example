# Copy this file to .env and fill in your values
# Never commit .env to version control — it contains secrets.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/netcontrol

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Token expiry in minutes (default 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application log level — DEBUG, INFO, WARNING, ERROR. Controls what shows up
# in the systemd journal (or console in dev). INFO surfaces routine events
# like "email sent" / "net pushed to Net Repository"; WARNING+ is quieter.
LOG_LEVEL=INFO

# ── Deployment ────────────────────────────────────────────────────────────────
# Lets one server run multiple instances (e.g. production + a demo site) from
# separate checkouts without editing deploy.sh or the systemd unit by hand —
# each instance just needs its own .env, port, and unit name. See "Deployment"
# in README.md for the full systemd template.

# Port uvicorn listens on. The systemd ExecStart line reads this via ${PORT}.
PORT=8000

# systemd unit name (without ".service") that deploy.sh restarts after pulling.
# Must match the .service filename for this instance.
SYSTEMD_SERVICE=nettracker

# Git branch this instance tracks — deploy.sh checks out and pulls exactly
# this branch, regardless of whatever's currently checked out locally. Use
# "main" for the stable instance and "testing" for a pre-release instance,
# so the same deploy.sh works unmodified for both. Defaults to "main" if unset.
GIT_BRANCH=main

# ── Email / SMTP ────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable email entirely (all email calls are silently skipped).
#
# Common configurations:
#   Gmail (App Password): HOST=smtp.gmail.com  PORT=587  USE_TLS=true  USE_SSL=false
#   Gmail (SSL):          HOST=smtp.gmail.com  PORT=465  USE_TLS=false USE_SSL=true
#   SendGrid:             HOST=smtp.sendgrid.net PORT=587 USER=apikey  PASSWORD=<your-api-key>
#   Local/Postfix:        HOST=localhost        PORT=25   USE_TLS=false USE_SSL=false (no login needed)
#
# If SMTP_HOST points at your own domain, make sure that DNS record is NOT
# proxied through Cloudflare (i.e. it's set to "DNS only" / grey cloud, not
# orange). A proxied record routes SMTP traffic through Cloudflare's edge,
# which most mail servers don't expect on that port — the connection can
# hang rather than fail outright (SMTP_TIMEOUT_SECONDS below bounds how long
# that hang lasts, but the fix is to stop proxying the record).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
# "Display Name <address>" or just an address
SMTP_FROM=Ham Net Tracker <your@gmail.com>
# STARTTLS (port 587) — set true for most providers
SMTP_USE_TLS=true
# SSL/TLS (port 465) — set true only if using port 465
SMTP_USE_SSL=false
# Max seconds to wait on the SMTP connection/login/send before giving up.
# Emails are sent synchronously inside the request that triggers them (e.g.
# registration) — a slow or unreachable host would otherwise hang that
# request instead of just failing the email.
SMTP_TIMEOUT_SECONDS=10

# Public URL of this instance (no trailing slash) — used to build links in
# emails (verify-your-email, account-approved). Leave blank to omit those
# links; the emails are still sent, just without a clickable link back.
APP_BASE_URL=https://netcontrol.example.org

# ── Contact addresses ────────────────────────────────────────────────────────
# Email shown to users in approval emails as a human contact point
ADMIN_CONTACT_EMAIL=admin@example.com
# Helpdesk/support address where in-app problem reports are sent
SUPPORT_EMAIL=support@example.com

# ── Net Repository (optional) ─────────────────────────────────────────────────
# Pushes nets with "List in Public Net Directory" enabled to a central,
# community-run directory: https://github.com/LadyHwesta/Net-Repository
# Leave NET_REPOSITORY_URL blank to disable — nothing is sent anywhere.
# NET_REPOSITORY_URL=https://mynetrepo.meskis.net
#
# NET_REPOSITORY_API_KEY is optional — leave it unset and request a key
# self-service instead from Admin > Net Repository (stored in the database,
# not here; takes effect immediately, no restart). Set this only if you'd
# rather have the Net Repository admin issue a key directly; it takes
# precedence over a self-service key if both are present.
# NET_REPOSITORY_API_KEY=nr_xxxxxxxxxxxxxxxxxxxx

# ── Bot protection on registration/login (optional) ───────────────────────────
# A widget on the login/register form, verified server-side before the
# request goes through. Pick exactly ONE provider by setting CAPTCHA_PROVIDER
# to "turnstile", "recaptcha", or "altcha" and filling in that provider's
# section below. Leave CAPTCHA_PROVIDER unset (or blank) to disable entirely
# — no widget renders, nothing is required or verified.
# CAPTCHA_PROVIDER=turnstile

# Cloudflare Turnstile — free at https://dash.cloudflare.com/?to=/:account/turnstile
# (works even if the site isn't proxied through Cloudflare). Add this app's
# actual domain as the widget's hostname.
# TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
# TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google reCAPTCHA (v2 checkbox) — free at https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ALTCHA (https://altcha.org, MIT-licensed, open source) — a real
# self-contained alternative to the two above: no third-party account, no
# external verification service, no site key. This app issues and checks its
# own proof-of-work challenges using ALTCHA_HMAC_KEY, a private value only
# this server needs (any long random string). Auto-generated at startup if
# left unset, which is fine for a single instance — set it explicitly if you
# run more than one worker/instance so they all agree on the same key.
# ALTCHA_HMAC_KEY=change-me-to-a-long-random-string

# ── UI Translation (optional, off by default) ─────────────────────────────────
# Translates the app's UI using Argos Translate (argosopentech/argos-translate),
# an offline neural MT library -- no third-party API. This is a genuinely heavy
# dependency (pulls in ctranslate2/spacy/stanza); leave unset unless you intend
# to use it. Requires `pip install argostranslate` and, after restarting,
# enabling at least one language from Admin -> Languages. See README's
# "UI Translation" section for the full setup.
# TRANSLATION_ENABLED=true

# ── GitHub (optional — only needed for repo management) ──────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_USER=your_github_username
