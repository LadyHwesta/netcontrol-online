# Environment / secrets
.env

# Uploaded files (logos etc.) — instance-specific, not part of the repo
uploads/

# Pre-deploy database backups (deploy.sh, main instances only) — instance-
# specific, and can get large; never belongs in the repo
backups/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backup / scratch files — don't commit these
*.bak
*_old.*
*_backup.*

# Archives
*.zip
*.tar.gz

# Logs
*.log

# Auth failure log (instance-specific, written at runtime)
auth.log

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Shell / system files (home directory artifacts)
.bash_history
.bash_logout
.bashrc
.bash_profile
.profile
.cloud-locale-test.skip
.psql_history
.viminfo
.lesshst
.wget-hsts
